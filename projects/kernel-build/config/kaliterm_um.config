# kaliterm UML kernel — config-fragment.
#
# Ez a fragment a `make ARCH=um SUBARCH=<host> defconfig` mellé merge-elődik.
# Csak azokat a kapcsolókat soroljuk fel, amik a "stock" UM defconfig fölött
# kellenek nekünk. Ha új driver kell, ide kerül egy sor és a CI újrabuildel.
#
# Útmutató:
#   y = beépítve a kernelbe
#   m = modulként (ha CONFIG_MODULES=y is be van kapcsolva)
#   nincs sor = a defconfig értéke érvényes
#
# Fázis 0: minimális, csak hostfs + tty + initramfs alapok.
# Fázis 2+ tölti fel a tényleges driver-kapcsolókkal (lásd terv).

CONFIG_LOCALVERSION="-kaliterm"

# Initramfs / boot
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# A hoszt fájlrendszer látható lesz a UML-ben — debug-hoz nélkülözhetetlen.
CONFIG_HOSTFS=y

# Alap rendszer
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# TTY a terminálhoz
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y

# Modul-támogatás (későbbi fázisokban kell, hogy be tudjunk tölteni új drivert
# úgy, hogy nem kell újrafordítani a teljes kernelt).
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
