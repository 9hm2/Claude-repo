# kaliterm LKL kernel — config-fragment.
#
# Ez a fragment a `make ARCH=lkl defconfig` mellé merge-elődik. Csak azokat
# a kapcsolókat soroljuk fel, amik a stock LKL defconfig fölött kellenek.
#
# Új driver hozzáadása: ide egy `CONFIG_*=y` sor, push → CI újrabuildel.
# A Kconfig `select`/`depends` szabályok automatikusan rángatják be a
# függőségeket az `olddefconfig` lépésben.

CONFIG_LOCALVERSION="-kaliterm"

# Diagnosztika a fejlesztéshez.
CONFIG_PRINTK=y

# Modul-támogatás (=m célok kedvéért később).
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Fájlrendszerek a chrootolható environment-hez.
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# === Fázis 1: USB stack + USB/IP virtual HCD ============================
#
# Az LKL-be **nem** írunk saját USB host controller driver-t. Helyette a
# mainline `vhci_hcd` (USB/IP) driver-t kapcsoljuk be — ez pont egy
# "socket-on-jövő URB"-eket lekezelő virtuális HCI.
#
# A host oldali bridge (projects/usb-bridge/) USB/IP protokollt beszél
# egy Unix socketen át, és libusb-vel a tényleges Android UsbManager-en
# továbbít. A vhci_hcd-hez attach-olt FD a kernel-belsőben URB-eket cserél.
# Eredmény: a Linux USB core úgy látja az eszközt, mintha helyi USB busz
# lenne.

# Hálózat (a USB/IP TCP/Unix socket-eket használ a vhci_hcd FD-jén).
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
# Network namespaces — néhány initcall (köztük unix_init pernet_subsys-e)
# erre épít. NET_NS=n esetén lehet hogy az AF_UNIX nem regisztrálódik.
CONFIG_NET_NS=y

# USB core.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_COMMON=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y

# USB/IP — a "host op" driverünk a mainline-ban.
CONFIG_USBIP_CORE=y
CONFIG_USBIP_VHCI_HCD=y
# CONFIG_USBIP_VHCI_HC_PORTS = mainline default 8 — bőven elég

# TTY layer (a USB serial drivers ezt használják).
CONFIG_TTY=y

# USB serial — full mainline driver-pack (CH340, FTDI, CP210x, PL2303,
# Keyspan, Option/Qualcomm modemek, MOS chip-ek, MCT, stb.).
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_KEYSPAN=y
CONFIG_USB_SERIAL_KEYSPAN_PDA=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_SERIAL_QUALCOMM=y
CONFIG_USB_SERIAL_MOS7720=y
CONFIG_USB_SERIAL_MOS7840=y
CONFIG_USB_SERIAL_MCT_U232=y
CONFIG_USB_SERIAL_OTI6858=y
CONFIG_USB_SERIAL_QCAUX=y
CONFIG_USB_SERIAL_SIERRAWIRELESS=y
CONFIG_USB_SERIAL_SAFE=y
CONFIG_USB_SERIAL_TI=y
CONFIG_USB_SERIAL_VISOR=y
CONFIG_USB_SERIAL_WHITEHEAT=y
CONFIG_USB_SERIAL_WWAN=y

# === USB HID + általános HID támogatás ==================================
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_USB_HIDDEV=y
# Egzotikus HID device family-k (gaming-vendorok, billentyűzetek):
CONFIG_HID_APPLE=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_NINTENDO=y
CONFIG_HID_SONY=y
CONFIG_HID_STEAM=y
CONFIG_HID_RAZER=y
CONFIG_HID_WACOM=y
CONFIG_HID_MULTITOUCH=y

# === LED subsystem + USB LED-ek (BlinkStick, ThingM, MAUSBERRY) =========
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_ONESHOT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_BLINKM=y
CONFIG_LEDS_USB=y
CONFIG_USB_LEDS_TRIGGER_USBPORT=y
# HID-on lévő LED-eknek: usbhid + hid-thingm/-blink1 (ezek a HID stack-en mennek)
CONFIG_HID_THINGM=y

# === Bluetooth USB stack (btusb + BlueZ subsystem) ======================
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HS=y
CONFIG_BT_LE=y
CONFIG_BT_LEDS=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_AUTOSUSPEND=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y

# === Wireless 80211 framework + USB Wi-Fi driverek ======================
# cfg80211 + mac80211 = a kernel WiFi-stack-je. Nélkülük az userspace
# `iw`, `iwconfig`, `wpa_supplicant`, `airodump-ng`, stb. nem működik.
CONFIG_CFG80211=y
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_NL80211_TESTMODE=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_HAS_RC=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_LEDS=y
CONFIG_MAC80211_MESH=y
CONFIG_WLAN=y

# Realtek RTL8XXXU (rtl8723a/b, 8188cu/eu, 8192cu/eu, ...) — a mainline
# fa NEM tartalmazza a RTL8821AU/RTL8812AU silicon-kódot, ezért a TP-Link
# Archer T2U Plus (2357:011e) chipset-éhez az out-of-tree morrownr/8812au
# driver kell — lentebb CONFIG_RTL8812AU=y.
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL_CARDS=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
# Realtek RTL8812AU/RTL8821AU/RTL8811AU/RTL8814AU out-of-tree driver
# (morrownr/8812au-20210820 fork — aktívan karbantartott). Source-t a
# scripts/fetch-rtl8812au.sh injektálja a kernel-tree-be a fetch utáni
# patch-fázisban. A patches/0004-realtek-rtl8812au-integration.patch a
# parent realtek/Kconfig + Makefile-be fűzi a subdirektoriát.
CONFIG_RTL8812AU=y
# Realtek 802.11ac (8821ce/8822be/8852ae) — staging-ben még; bekapcsoljuk.
CONFIG_RTW88=y
CONFIG_RTW88_8822BU=y
CONFIG_RTW88_8821CU=y
CONFIG_RTW88_8723DU=y
CONFIG_RTW89=y
CONFIG_RTW89_8852AE=y

# Atheros AR9170 (CARL9170), AR9271 (ATH9K_HTC) — firmware kell még hozzá.
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=y
CONFIG_ATH9K_HW=y
CONFIG_ATH9K_COMMON=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y
CONFIG_ATH6KL=y
CONFIG_ATH6KL_USB=y

# MediaTek MT76 USB chip-ek (MT7601U, MT76x0U, MT76x2U, MT7663U)
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=y
CONFIG_MT76_USB=y
CONFIG_MT76x0_COMMON=y
CONFIG_MT76x0U=y
CONFIG_MT76x2_COMMON=y
CONFIG_MT76x2U=y
CONFIG_MT7663U=y

# Ralink RT2x00 (RT2500USB, RT73USB, RT2800USB)
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2500USB=y
CONFIG_RT73USB=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y

# Broadcom FullMAC USB (b43, brcmfmac)
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_USB=y

# Marvell USB Wi-Fi (mwifiex_usb)
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_MWIFIEX=y
CONFIG_MWIFIEX_USB=y

# Redpine RSI 91x USB
CONFIG_WLAN_VENDOR_RSI=y
CONFIG_RSI_91X=y
CONFIG_RSI_USB=y

# === USB Ethernet driverek (USB-NIC dongle-ok) ==========================
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDC_MBIM=y
CONFIG_USB_NET_DM9601=y
CONFIG_USB_NET_SR9700=y
CONFIG_USB_NET_SR9800=y
# smsc75xx / smsc95xx: hasonlóan a lan78xx-hez, belső MDIO PHY-jük az
# irq_domain framework-öt használja az interrupt-routinghoz; LKL-ben nincs
# hardver-IRQ-domain. Kikapcsolva.
# CONFIG_USB_NET_SMSC75XX is not set
# CONFIG_USB_NET_SMSC95XX is not set
CONFIG_USB_NET_GL620A=y
CONFIG_USB_NET_NET1080=y
CONFIG_USB_NET_PLUSB=y
CONFIG_USB_NET_MCS7830=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_CDC_SUBSET=y
CONFIG_USB_NET_ZAURUS=y
CONFIG_USB_RTL8150=y
CONFIG_USB_RTL8152=y
# CONFIG_USB_LAN78XX — irq_domain_add_simple()-t hív, ami LKL-ben nincs
# (nincs hardver-IRQ-domain).  A driver kikapcsolva.
# CONFIG_USB_LAN78XX is not set
CONFIG_USB_HSO=y
CONFIG_USB_IPHETH=y

# === USB Mass Storage =================================================
CONFIG_BLOCK=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_STORAGE_DATAFAB=y
CONFIG_USB_STORAGE_FREECOM=y
CONFIG_USB_STORAGE_ISD200=y
CONFIG_USB_STORAGE_USBAT=y
CONFIG_USB_STORAGE_SDDR09=y
CONFIG_USB_STORAGE_SDDR55=y
CONFIG_USB_STORAGE_JUMPSHOT=y
CONFIG_USB_STORAGE_ALAUDA=y
CONFIG_USB_STORAGE_ONETOUCH=y
CONFIG_USB_STORAGE_KARMA=y
CONFIG_USB_STORAGE_CYPRESS_ATACB=y
CONFIG_USB_STORAGE_ENE_UB6250=y

# Block-on-USB-hez fájlrendszerek (mountoláshoz külső pendrive-okat).
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_NTFS3_FS=y
CONFIG_ISO9660_FS=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_UTF8=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_852=y

# === USB egyéb device-class-ok =========================================
# CDC Modem (smartphone tethering, USB modemek), printer, usbtmc (műszer):
CONFIG_USB_ACM=y
CONFIG_USB_PRINTER=y
CONFIG_USB_TMC=y

# USB Audio (snd-usb-audio) + ALSA
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# USB Video (UVC webcam-class)
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y
CONFIG_USB_GSPCA=y

# USB-PD / Type-C alrendszer (modern USB-C dongle-okhoz):
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y

# === Network protokollok és frameworkok =================================
# Wi-Fi sniff/inject + 802.11-csomagdump és hálózati standard funkciók
CONFIG_PACKET=y                 # raw socket-ek (tcpdump, libpcap)
CONFIG_PACKET_DIAG=y
CONFIG_INET_DIAG=y              # ss, netstat
CONFIG_NETFILTER=y              # iptables/nftables alapja
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=y
CONFIG_BRIDGE=y                 # bridging (bnep használja)
CONFIG_VLAN_8021Q=y
CONFIG_TUN=y                    # /dev/net/tun (OpenVPN, WireGuard userspace)
CONFIG_PPP=y
CONFIG_PPP_BSDCOMP=y
CONFIG_PPP_DEFLATE=y
CONFIG_PPP_ASYNC=y
CONFIG_PPP_SYNC_TTY=y
CONFIG_PPPOE=y
