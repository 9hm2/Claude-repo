# kaliterm LKL kernel — config-fragment.
#
# Ez a fragment a `make ARCH=lkl defconfig` mellé merge-elődik. Csak azokat
# a kapcsolókat soroljuk fel, amik a stock LKL defconfig fölött kellenek.
#
# Új driver hozzáadása: ide egy `CONFIG_*=y` sor, push → CI újrabuildel.
#
# Fázis 0: minimális. A drivereket a Fázis 3-tól kezdjük tölteni.

CONFIG_LOCALVERSION="-kaliterm"

# A `printk` és némi diagnosztika kelleni fog a fejlesztéshez.
CONFIG_PRINTK=y

# Modul-támogatás később hasznos — futás közbeni driver-load nélkül is
# (kell hogy a beépített drivereink rendesen exponáljanak struktúrákat).
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Alapvető fájlrendszerek a chrootolható environment-hez.
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
